# These are set in Vercel under Project Settings → Environment Variables.
# The Neon and Blob integrations create most of them automatically.
#
# After deploying, open /api/health to see which ones the app actually found,
# then /api/setup once to create the tables.

# Database — the app uses the first one that is set.
DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Vercel Blob — the app uses the first one that is set. Vercel adds a prefix
# (BLOB2_, BLOB3_, ...) when a store is recreated or a second one is added.
BLOB_READ_WRITE_TOKEN=
# BLOB2_READ_WRITE_TOKEN=

# Gemini API key — the app uses the first one that is set.
GOOGLE_AI=
# GEMINI_API_KEY=
